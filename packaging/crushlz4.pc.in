# Relocatable on purpose: prefix is derived from where this file actually
# sits, not from the prefix baked in at configure time, so `cmake --install
# --prefix` and a relocated install tree both resolve correctly.
prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: crushlz4
Description: A denser Apple-LZ4 encoder for APFS transparent compression (decmpfs 15/16), plus the decoder
Version: @PROJECT_VERSION@
URL: @PROJECT_HOMEPAGE_URL@
Libs: -L${libdir} -lcrushlz4
Cflags: -I${includedir}
